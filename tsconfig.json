{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0"
  },
  "include": ["app.ts", "bin/**/*.ts", "routes/**/*.ts", "utils/**/*.ts", "test/**/*.ts"]
}