{
  "name": "express",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./dist/bin/www.js",
    "test": "npm run build && node --test dist/test/*.test.js && jasmine --config=jasmine.json",
    "build": "npm run lint && npm run formate && tsc",
    "lint": "eslint \"{app.ts,bin/**/*.ts,routes/**/*.ts,utils/**/*.ts,test/**/*.ts}\"",
    "formate": "prettier --check \"{app.ts,bin/**/*.ts,routes/**/*.ts,utils/**/*.ts,test/**/*.ts}\""
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "~4.17.1",
    "http-errors": "~1.6.3",
    "jade": "~1.11.0",
    "morgan": "~1.9.1",
    "sharp": "^0.34.5"
  },
  "//": [
    "Kindly do not change the version 4.2.3 of mongodbMemoryServer config"
  ],
  "config": {
    "mongodbMemoryServer": {
      "version": "4.2.3"
    }
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.3",
    "@types/http-errors": "^2.0.4",
    "@types/jasmine": "^5.1.9",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.5.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.36.0",
    "jasmine": "^5.1.0",
    "jasmine-spec-reporter": "^7.0.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1"
  }
}
